{
  "comment": "What the sandbox's MCP stand-ins serve: the catalog's four tools (labs/ch06/catalog/tools.yaml), by server. get_pod_status and get_recent_alerts are chapter 5's definitions as its lock pins them (labs/ch05/mcp-server/tools.lock.json); restart_deployment and search_runbooks are written here in the same shape, since their servers arrive in Part III. The image's lock for the sandbox is written from this file (sandbox.py image), so the harness's check against the gateway's list is a check of what the gateway relays.",
  "servers": {
    "k8s-mcp": ["get_pod_status", "get_recent_alerts", "restart_deployment"],
    "knowledge-mcp": ["search_runbooks"]
  },
  "tools": {
    "get_pod_status": {
      "name": "get_pod_status",
      "description": "Pod counts and restarts for one deployment. Read-only.",
      "inputSchema": {
        "properties": {"service": {"title": "Service", "type": "string"}},
        "required": ["service"],
        "title": "get_pod_statusArguments",
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "Pod": {
            "properties": {
              "name": {"title": "Name", "type": "string"},
              "phase": {"title": "Phase", "type": "string"},
              "restarts": {"title": "Restarts", "type": "integer"}
            },
            "required": ["name", "phase", "restarts"],
            "title": "Pod",
            "type": "object"
          }
        },
        "properties": {
          "service": {"title": "Service", "type": "string"},
          "namespace": {"title": "Namespace", "type": "string"},
          "ready": {"title": "Ready", "type": "integer"},
          "desired": {"title": "Desired", "type": "integer"},
          "image": {"title": "Image", "type": "string"},
          "pods": {"items": {"$ref": "#/$defs/Pod"}, "title": "Pods", "type": "array"}
        },
        "required": ["service", "namespace", "ready", "desired", "image", "pods"],
        "title": "PodStatus",
        "type": "object"
      },
      "annotations": {"readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false}
    },
    "get_recent_alerts": {
      "name": "get_recent_alerts",
      "description": "Return the alerts that fired for one deployment within the last N minutes (1 to 1440), newest first, with severity and summary. Read-only.",
      "inputSchema": {
        "properties": {
          "service": {"title": "Service", "type": "string"},
          "minutes": {"title": "Minutes", "type": "integer"}
        },
        "required": ["service", "minutes"],
        "title": "get_recent_alertsArguments",
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "Alert": {
            "properties": {
              "service": {"title": "Service", "type": "string"},
              "severity": {"enum": ["critical", "warning", "info"], "title": "Severity", "type": "string"},
              "age_minutes": {"title": "Age Minutes", "type": "integer"},
              "source": {"title": "Source", "type": "string"},
              "summary": {"title": "Summary", "type": "string"}
            },
            "required": ["service", "severity", "age_minutes", "source", "summary"],
            "title": "Alert",
            "type": "object"
          }
        },
        "properties": {
          "service": {"title": "Service", "type": "string"},
          "window_minutes": {"title": "Window Minutes", "type": "integer"},
          "count": {"title": "Count", "type": "integer"},
          "alerts": {"items": {"$ref": "#/$defs/Alert"}, "title": "Alerts", "type": "array"}
        },
        "required": ["service", "window_minutes", "count", "alerts"],
        "title": "AlertList",
        "type": "object"
      },
      "annotations": {"readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false}
    },
    "restart_deployment": {
      "name": "restart_deployment",
      "description": "Roll the pods of one deployment by patching its restart annotation. A write: the change advisory board's approval is checked before it runs.",
      "inputSchema": {
        "properties": {"service": {"title": "Service", "type": "string"}},
        "required": ["service"],
        "title": "restart_deploymentArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "service": {"title": "Service", "type": "string"},
          "namespace": {"title": "Namespace", "type": "string"},
          "restarted_at": {"title": "Restarted At", "type": "string"}
        },
        "required": ["service", "namespace", "restarted_at"],
        "title": "RestartResult",
        "type": "object"
      },
      "annotations": {"readOnlyHint": false, "destructiveHint": false, "idempotentHint": false, "openWorldHint": false}
    },
    "search_runbooks": {
      "name": "search_runbooks",
      "description": "Search the runbook corpus for the passages that match a question, best first, with the runbook each comes from. Read-only.",
      "inputSchema": {
        "properties": {"query": {"title": "Query", "type": "string"}},
        "required": ["query"],
        "title": "search_runbooksArguments",
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "Passage": {
            "properties": {
              "runbook": {"title": "Runbook", "type": "string"},
              "text": {"title": "Text", "type": "string"},
              "score": {"title": "Score", "type": "number"}
            },
            "required": ["runbook", "text", "score"],
            "title": "Passage",
            "type": "object"
          }
        },
        "properties": {
          "query": {"title": "Query", "type": "string"},
          "passages": {"items": {"$ref": "#/$defs/Passage"}, "title": "Passages", "type": "array"}
        },
        "required": ["query", "passages"],
        "title": "RunbookSearch",
        "type": "object"
      },
      "annotations": {"readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false}
    }
  }
}
