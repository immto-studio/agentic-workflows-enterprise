# Langfuse's environment for the session (cloud/terraform/vm.tf): the Compose file's CHANGEME values and
# the headless init (fact sheet 8.5). Values are not double-quoted, as Langfuse's page asks.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=${nextauth_secret}
SALT=${salt}
ENCRYPTION_KEY=${encryption_key}
TELEMETRY_ENABLED=false
DATABASE_URL=postgresql://postgres:${store_password}@postgres:5432/postgres
POSTGRES_PASSWORD=${store_password}
CLICKHOUSE_PASSWORD=${store_password}
REDIS_AUTH=${store_password}
MINIO_ROOT_PASSWORD=${store_password}
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=${store_password}
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=${store_password}
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=${store_password}
LANGFUSE_INIT_ORG_ID=larkspur
LANGFUSE_INIT_ORG_NAME=Larkspur
LANGFUSE_INIT_PROJECT_ID=ch16-lab
LANGFUSE_INIT_PROJECT_NAME=Chapter 16 lab
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=${public_key}
LANGFUSE_INIT_PROJECT_SECRET_KEY=${secret_key}
LANGFUSE_INIT_USER_EMAIL=${user_email}
LANGFUSE_INIT_USER_NAME=Lab
LANGFUSE_INIT_USER_PASSWORD=${user_password}
